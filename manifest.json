{
  "manifest_version": 3,
  "name": "Keep My Monitors Awake",
  "version": "2.3.0",
  "description": "Keeps studio monitors awake with a smart signal that pauses during browser audio and calls.",
  "author": "Franck Dupont",
  "minimum_chrome_version": "109",
  "permissions": [
    "alarms",
    "idle",
    "offscreen",
    "storage",
    "tabs"
  ],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "action": {
    "default_icon": {
      "16": "images/awake-logo-on16.png",
      "32": "images/awake-logo-on32.png",
      "48": "images/awake-logo-on48.png",
      "128": "images/awake-logo-on128.png"
    },
    "default_title": "Keep My Monitors Awake"
  },
  "icons": {
    "16": "images/awake-logo-on16.png",
    "32": "images/awake-logo-on32.png",
    "48": "images/awake-logo-on48.png",
    "128": "images/awake-logo-on128.png"
  }
}
